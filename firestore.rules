rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'kushanashvika216@gmail.com' ||
        request.auth.token.admin == true
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Public Movies Catalog: Anyone can read, only admin can create/edit/delete
    match /movies/{movieId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public TV / Anime Series: Anyone can read, only admin can write
    match /series/{seriesId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Series Episodes: Anyone can read, only admin can write
    match /episodes/{episodeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Dynamic Homepage Rails
    match /homepageSections/{sectionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Platform Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User Watchlists & History
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();

      match /watchlist/{contentId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /history/{contentId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Audit Logs: Admin only
    match /auditLogs/{logId} {
      allow read, write: if isAdmin();
    }

    // Fallback rule
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
